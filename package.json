{
  "name": "curso-omotenashi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "node --test tests/auth-regression.test.cjs",
    "test:integration": "node tests/integration.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "npx prisma generate && next build --webpack",
    "vercel-build": "npx prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; fi && next build --webpack",
    "db:push": "prisma db push",
    "db:seed": "npx tsx --experimental-wasm-modules -e \"fetch('https://curso-omotenashi.vercel.app/api/seed').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "start": "next start",
    "postinstall": "",
    "deploy": "node ./node_modules/.bin/vercel deploy --prod --yes"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "react-player": "^2.16.0",
    "stripe": "^17.3.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "postcss": "^8.5.28",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "effect": "^3.22.2",
    "deepmerge-ts": "^8.0.2"
  }
}
