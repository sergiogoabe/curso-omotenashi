# Database (Neon PostgreSQL)
# DATABASE_URL = pooled connection (usada pela app em runtime)
# DATABASE_URL_UNPOOLED = conexão direta (usada por prisma migrate/generate)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key"
NEXTAUTH_URL="https://seu-dominio.vercel.app"

# App URL
NEXT_PUBLIC_APP_URL="https://seu-dominio.vercel.app"

# Asaas (pagamento principal: PIX recorrente)
# ASAAS_ENV = "sandbox" | "homologacao" | producao (qualquer outro valor usa producao)
ASAAS_ENV="sandbox"
ASAAS_API_KEY="_live_... ou _sandbox_..."
# Chave usada para validar o header asaas-signature do webhook (HMAC-SHA256, timing-safe)
# Deve ser a MESMA chave registrada no painel Asaas (Integracoes > Webhook)
ASAAS_WEBHOOK_SECRET="chave-do-webhook-asaas"

# Stripe (LEGADO - rotas /api/stripe removidas do codigo; pagamento e 100% Asaas/PIX)
# Only keep STRIPE_* vars if any integration is re-added.
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (envio de email: fluxo de reset de senha - IMPLEMENTADO em lib/email.ts)
# Sem RESEND_API_KEY, o token de reset cai no console do servidor (fallback de dev)
RESEND_API_KEY="re_xxxxx"
EMAIL_FROM="Omotenashi <no-reply@seu-dominio.com>"

# Admin login (gate das áreas protegidas: /admin e /dashboard)
ADMIN_USERNAME="seu-usuario"
ADMIN_PASSWORD="sua-senha-forte"

# Upstash Redis (rate limiting distribuído - RECOMENDADO para produção)
# Se não configurado, usa fallback in-memory (não compartilhado entre instâncias serverless)
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# Sentry Error Monitoring (RECOMENDADO para produção)
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# SENTRY_AUTH_TOKEN="sntrys_xxxxx"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
